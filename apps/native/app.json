{
	"expo": {
		"scheme": "simple-commerce",
		"userInterfaceStyle": "automatic",
		"orientation": "default",
		"web": {
			"bundler": "metro"
		},
		"name": "simple-commerce",
		"slug": "simple-commerce",
		"plugins": ["expo-font", "expo-web-browser", "expo-secure-store"],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"android": {
			"package": "com.simplecommerce.app"
		}
	}
}
