{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "NODE_ENV=production bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile dist/server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"@simple-commerce/api": "workspace:*",
		"@simple-commerce/auth": "workspace:*",
		"@simple-commerce/db": "workspace:*",
		"@simple-commerce/env": "workspace:*",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.1",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@simple-commerce/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"tsdown": "^0.20.3",
		"typescript": "catalog:"
	}
}
