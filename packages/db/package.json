{
	"name": "@simple-commerce/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./schema": {
			"default": "./src/schema/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"clean": "git clean -xdf .turbo node_modules",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "bun with-env bun run src/seed.ts",
		"db:reset": "bun with-env bun run src/reset.ts",
		"db:start": "docker compose up -d",
		"db:watch": "docker compose up",
		"db:stop": "docker compose stop",
		"db:down": "docker compose down",
		"with-env": "dotenv -e ../../apps/server/.env --"
	},
	"dependencies": {
		"@simple-commerce/env": "workspace:*",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.1",
		"pg": "^8.17.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@simple-commerce/config": "workspace:*",
		"@types/pg": "^8.16.0",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.9",
		"typescript": "catalog:"
	}
}
